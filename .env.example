# Frontend runtime configuration
# Local development usually points at localhost.
# Production should point at the deployed Fly API.
VITE_API_BASE_URL=http://localhost:4000/v1
# Example production value:
# VITE_API_BASE_URL=https://provance-api.fly.dev/v1

# Supabase client-side configuration
VITE_SUPABASE_URL=https://dmhrwdcuwtgscwlaagsa.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional client-side tuning
# VITE_SITE_URL=https://provanc3.vercel.app

# Frontend — Better Auth mode (parallel auth provider at /api/auth).
# Flip VITE_USE_BETTER_AUTH to true to route AuthContext + the sign-in and
# security pages through the better-auth client instead of mock/GoTrue.
# VITE_USE_BETTER_AUTH=true
# VITE_BETTER_AUTH_URL=http://localhost:4000

# Backend — Better Auth (optional parallel auth provider; stateless until
# DATABASE_URL is set — the Supabase Postgres connection string from the
# dashboard. Generate BETTER_AUTH_SECRET with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
DATABASE_URL=
